##### Terminal #####
set -g default-terminal "tmux-256color"
set -as terminal-overrides ',*:Tc'

##### Shell #####
# 若系统已安装 zsh，优先将其设为默认 shell（按系统默认 -> 用户/Homebrew 顺序覆盖）
{{- $zshPaths := list "/bin/zsh" "/usr/bin/zsh" "/usr/local/bin/zsh" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $zshPaths = list "/bin/zsh" "/usr/local/bin/zsh" "/opt/homebrew/bin/zsh" (joinPath .chezmoi.homeDir ".local/bin/zsh") }}
{{- else if eq .chezmoi.os "linux" }}
{{-   $zshPaths = list "/bin/zsh" "/usr/bin/zsh" "/usr/local/bin/zsh" "/home/linuxbrew/.linuxbrew/bin/zsh" (joinPath .chezmoi.homeDir ".local/bin/zsh") }}
{{- end }}
{{- $detectedZsh := lookPath "zsh" }}
{{- if and $detectedZsh (not (has $detectedZsh $zshPaths)) }}
{{-   $zshPaths = append $zshPaths $detectedZsh }}
{{- end }}
{{- range $zshPaths }}
if-shell 'test -x {{ . | quote }}' 'set -g default-shell {{ . | quote }}'
{{- end }}

##### Input #####
set -s escape-time 10
set -g mouse on
set -g focus-events on
set -g extended-keys on
set -g extended-keys-format csi-u

# OSC52 support
set -s set-clipboard on
set -g allow-passthrough on

# vi copy mode
set -g mode-keys vi
bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi V send -X select-line

# 统一用 OSC52：把内容写入 tmux buffer 并“写到剪贴板通道”
bind-key -T copy-mode-vi y  send -X copy-pipe "tmux load-buffer -w -; tmux send -X clear-selection"
bind-key -T copy-mode-vi Y  send -X copy-pipe-and-cancel "tmux load-buffer -w -"
bind-key -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe "tmux load-buffer -w -; tmux send -X clear-selection"

##### Environment #####
set -ga update-environment "SSH_AUTH_SOCK SSH_CONNECTION DISPLAY"
{{- if eq .chezmoi.os "darwin" }}

##### macOS Keychain / Namespace #####
# 若安装了 reattach-to-user-namespace，通过它启动 login shell 以保留 Aqua/Keychain 访问上下文；
# 未安装时自动回退到普通 login shell，避免新 pane 启动失败。
set -g default-command 'if [ -x /opt/homebrew/bin/reattach-to-user-namespace ]; then exec /opt/homebrew/bin/reattach-to-user-namespace -l "${SHELL:-/bin/zsh}"; elif [ -x /usr/local/bin/reattach-to-user-namespace ]; then exec /usr/local/bin/reattach-to-user-namespace -l "${SHELL:-/bin/zsh}"; elif command -v reattach-to-user-namespace >/dev/null 2>&1; then exec reattach-to-user-namespace -l "${SHELL:-/bin/zsh}"; else exec "${SHELL:-/bin/zsh}" -l; fi'
{{- else if eq .chezmoi.os "linux" }}

##### Linux Keyring / D-Bus #####
# 同步 D-Bus Secret Service (libsecret / gnome-keyring) 与桌面会话环境变量
set -ga update-environment "DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR GNOME_KEYRING_CONTROL GNOME_KEYRING_PID WAYLAND_DISPLAY XAUTHORITY"
{{- end }}

##### History #####
set -g history-limit 100000
