[http]
        proxyAuthMethod = basic
[alias]
        st = status
        logl = log --pretty=oneline --abbrev-commit
        bl = blame
[diff]
        algorithm = histogram
        external = "sh -c 'if command -v difft >/dev/null 2>&1; then difft --display=inline --background=light \"$@\"; exit $?; fi; diff -u --label \"a/$1\" --label \"b/$1\" \"$2\" \"$5\"; status=$?; if [ \"$status\" -eq 1 ]; then exit 0; fi; exit \"$status\"' --"

[branch]
        sort = committerdate

[merge]
        conflictStyle = diff3

[commit]
        verbose = true

[rerere]
        enabled = true

{{- if or (eq .chezmoi.username "ruogui.ygr") (eq .chezmoi.username "ruogui") }}
[user]
        name = ruogui.ygr
        email = ruogui.ygr@alibaba-inc.com

[sendemail]
        smtpserver = /mnt/data/userdata/ruogui.ygr/.local/bin/msmtp
        smtpencryption = tls
        smtpuser = GuoRui.Yu@linux.alibaba.com
        smtpserverport = 465
        suppresscc = all
        signedoffbycc = false
        suppressfrom = true

[safe]
        directory = /mnt/data/userdata/ruogui.ygr/Code/
{{- else }}
[user]
        email = yuguorui@pku.edu.cn
        name = yuguorui
{{- end }}

